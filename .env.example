# Copy this file to .env and adjust values for your local environment.
# Do NOT commit the real .env file (it is gitignored).

# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- AWS / DynamoDB ---
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=fund_manager

# For local DynamoDB (e.g. docker), set the endpoint. Leave empty to use real AWS.
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# --- Security ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
