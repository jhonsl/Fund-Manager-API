# Copy this file to .env and adjust values for your local environment.
# Do NOT commit the real .env file (it is gitignored).

# --- App ---
ENVIRONMENT=local
DEBUG=true
PORT=8080

# --- AWS / DynamoDB ---
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=fund_manager

# Local DynamoDB endpoint. Used only when running the API OUTSIDE Docker.
# (Inside Docker, compose overrides this to http://dynamodb-local:8000.)
# Leave empty to use real AWS.
DYNAMODB_ENDPOINT_URL=http://localhost:8002

# --- Security ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
